# BlackBox MCP
#
# Five required variables. Everything else about the setup lives in Auth0 and
# Google Cloud, not here — see INSTALL.md, which is written in the order the
# steps have to happen in.

# --- Required ---------------------------------------------------------------

# Public URL of this deployment, and the only place it is written down.
#
# Four things derive from it and must agree: the MCP address, the OAuth resource
# identifier, the `audience` sent to Auth0, and the login callback. Locally that
# means the port `next dev` actually bound to — it takes the next free one if
# 3000 is busy, and a mismatch shows up as "Service not found" from Auth0.
#
# On Vercel this is detected automatically and can be left unset.
APP_URL=http://localhost:3000

# Your Auth0 tenant, without scheme or trailing slash.
AUTH0_DOMAIN=your-tenant.eu.auth0.com

# From the Regular Web Application in Auth0. INSTALL.md section 4.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Encrypts this app's session cookie. Auth0 never sees it. Use a different one
# per environment: sharing it means a stolen dev cookie works against production.
#   openssl rand -hex 32
AUTH0_SECRET=

# --- Optional ---------------------------------------------------------------

# The Auth0 connection Google sits behind. Every login goes straight to it, and
# it is the connection the token vault is read from. Default: google-oauth2
# AUTH0_CONNECTION=

# The `aud` an incoming access token must carry. Defaults to the MCP resource
# URL, which is what the Auth0 API should be registered as.
#
# `none` turns the check off. Last resort only — `aud` is what stops a token
# this tenant minted for some other API being replayed here.
# AUTH0_AUDIENCE=

# The GA4 property used when the model does not name one. Leave unset to make
# it call list_properties first.
# GA4_PROPERTY_ID=

# The BigQuery project used when the model does not name one. Leave unset to
# make it call list_datasets first.
# BIGQUERY_PROJECT_ID=

# Ceiling on what a single BigQuery query may scan, in bytes. Default 5 GB,
# roughly three US cents. BigQuery refuses a query that would exceed it rather
# than billing for it — which is what you want from a tool a language model
# drives. Set to 0 to remove the cap.
# BIGQUERY_MAX_BYTES_BILLED=

# The resource identifier tokens are issued for. Defaults to APP_URL + /api/mcp,
# which is what it should be. Set it only if the URL users type into Claude
# differs from that.
# MCP_RESOURCE_URL=
